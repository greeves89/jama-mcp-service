# JAMA MCP Service — Umgebungsvariablen
# Kopiere diese Datei nach .env und fuelle die Werte.
# Erzeugen lassen:  npm run secrets
# Die .env selbst wird NIE committet (siehe .gitignore).

# --- Datenbank ---------------------------------------------------------------
POSTGRES_USER=jama_mcp
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=jama_mcp
# Innerhalb von docker-compose ist der Host der Service-Name "postgres".
# Bei lokalem Betrieb ohne Docker: localhost:5432
DATABASE_URL=postgres://jama_mcp:CHANGE_ME@postgres:5432/jama_mcp

# --- Verschluesselung --------------------------------------------------------
# 32 Byte, base64-kodiert. Verschluesselt die Jama-Zugangsdaten in der Datenbank.
# ACHTUNG: Wird dieser Schluessel geaendert, sind ALLE gespeicherten
# Jama-Credentials unwiederbringlich verloren und muessen neu hinterlegt werden.
ENCRYPTION_KEY=CHANGE_ME

# --- Admin-Zugang ------------------------------------------------------------
# Initialer PIN, mindestens 8 Ziffern. Wird beim ersten Start als Argon2id-Hash
# in die Datenbank uebernommen und kann danach im Admin geaendert werden.
# Nach dem ersten Start kann dieser Wert entfernt werden.
ADMIN_INITIAL_PIN=CHANGE_ME

# Signiert die Admin-Session-Cookies. 32 Byte, base64-kodiert.
SESSION_SECRET=CHANGE_ME

# --- Server ------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# Anzahl der Proxys vor diesem Dienst. Die Anmeldesperre zaehlt Fehlversuche
# pro Client-Adresse; diese wird aus X-Forwarded-For gelesen. Ein zu hoher Wert
# laesst einen Angreifer eine erfundene Adresse voranstellen und die Sperre
# umgehen, ein zu niedriger laesst alle Anfragen von derselben Adresse kommen.
# 1 ist richtig, wenn genau ein nginx oder ein Traefik davor steht (Normalfall).
# Steht zusaetzlich ein CDN davor, entsprechend erhoehen.
TRUST_PROXY_HOPS=1

# Oeffentliche Basis-URL, unter der der Service erreichbar ist.
# Wird fuer die Copy-Snippets der MCP-Client-Konfiguration im Admin benutzt.
PUBLIC_BASE_URL=http://localhost:8081

# --- Betriebsgrenzen ---------------------------------------------------------
# Jama drosselt bei 10 Requests/Sekunde pro Instanz. Der Default laesst
# bewusst Luft fuer andere Integrationen.
JAMA_RATE_LIMIT_RPS=6
# Maximale Anzahl Wiederholungen nach HTTP 429 (Backoff 3/5/8/13 Sekunden).
JAMA_MAX_RETRIES=4
# Obergrenze fuer die geschaetzte Antwortgroesse eines Tool-Aufrufs, in Token.
MCP_RESPONSE_TOKEN_BUDGET=15000
# Aufbewahrung der Nutzungsdaten in Tagen.
USAGE_RETENTION_DAYS=180

# --- Notbremse ---------------------------------------------------------------
# Auf true setzen, um alle schreibenden Tools sofort global zu sperren.
# Laesst sich auch im Admin unter Einstellungen umschalten.
GLOBAL_READ_ONLY=false

# --- stdio-Modus (nur fuer lokalen Einzelbetrieb ohne Datenbank) -------------
# Wird nur von "npm run stdio" gelesen. Im Server-Modus irrelevant.
JAMA_BASE_URL=
JAMA_CLIENT_ID=
JAMA_CLIENT_SECRET=
JAMA_USERNAME=
JAMA_PASSWORD=

# --- Nur fuer docker-compose.traefik.yml + docker-compose.dbnet.yml ---------
# Docker-Netz, in dem die bestehende Datenbank haengt. Nur noetig, wenn
# Reverse-Proxy und Datenbank in verschiedenen Netzen liegen.
# Ermitteln mit:
#   docker inspect <db-container> --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
DB_NETWORK=
